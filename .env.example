# Local development environment variables
# Copy this file to .env and fill in your real values.

PORT=3000

# Discord OAuth
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=https://your-domain.com/auth/discord/callback

SESSION_SECRET=

# Firebase
FIREBASE_PROJECT_ID=amethyx-gang
FIREBASE_STORAGE_BUCKET=amethyx-gang.firebasestorage.app
FIREBASE_SERVICE_ACCOUNT=./path/to/service-account.json
# Alternatively, store the entire JSON content as the value of FIREBASE_SERVICE_ACCOUNT
